# Kalibr for camera / camera-IMU calibration on VIOLogger bags (arm64/amd64).
# Build:  docker build -t kalibr -f docker/Dockerfile.kalibr docker/
# Run via docker/run_kalibr_cameras.sh and docker/run_kalibr_imucam.sh
FROM ros:noetic-ros-base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget autoconf automake \
    python3-dev python3-pip python3-scipy python3-matplotlib \
    ipython3 python3-wxgtk4.0 python3-tk python3-igraph python3-pyx \
    libeigen3-dev libboost-all-dev libsuitesparse-dev \
    libopencv-dev libpoco-dev libtbb-dev libblas-dev liblapack-dev libv4l-dev \
    python3-catkin-tools python3-osrf-pycommon \
    ros-noetic-cv-bridge ros-noetic-image-transport ros-noetic-tf \
    && rm -rf /var/lib/apt/lists/*

# Pin kalibr (master as of clone date)
ARG KALIBR_COMMIT=1f60227442d25e36365ef5f72cd80b9666d73467
RUN mkdir -p /catkin_ws/src && cd /catkin_ws/src \
    && git clone https://github.com/ethz-asl/kalibr.git \
    && cd kalibr && git checkout ${KALIBR_COMMIT}

RUN . /opt/ros/noetic/setup.sh && cd /catkin_ws \
    && catkin config --extend /opt/ros/noetic --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && catkin build -j2   # -j2: same 8 GB VM memory ceiling as the OpenVINS build

# cv_bridge's boost python extension fails to initialize on arm64 noetic
# (both apt and source builds). Kalibr only needs imgmsg_to_cv2, so we shadow
# the module with a pure-python shim, prepended to PYTHONPATH in the entrypoint.
COPY cv_bridge_shim /shim

COPY entrypoint-kalibr.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
